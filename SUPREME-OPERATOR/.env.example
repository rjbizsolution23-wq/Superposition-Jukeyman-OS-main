# Environment Variables — Copy to .env.local and fill in real values
APP_NAME=supreme-operator
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://operator:changeme123@localhost:5432/supreme_operator
DB_PASSWORD=changeme123

# Redis
REDIS_URL=redis://:changeme123@localhost:6379
REDIS_PASSWORD=changeme123

# Claude API
ANTHROPIC_API_KEY=your-anthropic-key-here

# Cloudflare
CLOUDFLARE_API_TOKEN=your-cf-token-here
CLOUDFLARE_ACCOUNT_ID=your-cf-account-id
CLOUDFLARE_ZONE_ID=your-zone-id

# Stripe (Red-tier gated)
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key

# GitHub
GITHUB_TOKEN=your-github-token
GITHUB_USERNAME=rjbizsolution23-wq

# Windows Credential Manager scope
CREDENTIAL_SCOPE=agent-operations

# Risk thresholds
SPEND_DAILY_LIMIT=10.00
ACTION_BLAST_RADIUS_MAX=3

# Logging
LOG_LEVEL=info
AUDIT_RETENTION_DAYS=90